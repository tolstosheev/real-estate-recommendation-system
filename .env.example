# Database
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/nestai_db

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Yandex API
YANDEX_API_KEY=your-yandex-api-key
VITE_YANDEX_MAPS_API_KEY=your-yandex-maps-api-key
VITE_YANDEX_GEOCODER_API_KEY=your-yandex-geocoder-api-key

# MinIO (S3-compatible storage)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nestai-images
S3_PUBLIC_URL=http://localhost:8000/api/images

# Frontend API
VITE_API_URL=http://localhost:8000

# Pexels (для фото недвижимости в populate)
PEXELS_API_KEY=your-pexels-api-key

# App environment
APP_ENV=development
